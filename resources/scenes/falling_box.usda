#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 480
    timeCodesPerSecond = 60
)
def Xform "World"
{
    # SOMA is authored in centimeters; this scene uses meters.
    def Xform "Character"
    {
        double3 xformOp:translate = (2, 0, 0)
        double3 xformOp:translate.timeSamples = {
            0: (2, 0, 0),
            75: (2, 0, 0),
            405: (-1.575, 0, 0),
            480: (-1.575, 0, 0),
        }
        float xformOp:rotateY = -90
        double3 xformOp:scale = (0.01, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]

        def "Soma" (
            prepend references = @soma.usd@</OUTPUT>
        )
        {
            over "c_skeleton_grp" {
                over "Root" {
                    rel skel:animationSource = </World/Walk>
                }
            }
        }
    }
    def SkelAnimation "Walk" (prepend references = @soma_walk.usda@</Walk>) {}

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
        uniform token physxScene:broadphaseType = "MBP"
    }
    # A thin static slab with its top at y=0 provides the ground plane.
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, -0.1, 0)
        double3 xformOp:scale = (12, 0.2, 12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.22, 0.27, 0.32)]
    }
    def Xform "Box" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        float physics:mass = 1
        vector3f physics:velocity = (0, 0, 0)
        vector3f physics:angularVelocity = (0, 0, 0)
        def Cube "Geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.9, 0.35, 0.08)]
        }
    }
}
