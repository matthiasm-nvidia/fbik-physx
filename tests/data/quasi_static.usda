#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "World"
{
    def PhysicsScene "Physics" (prepend apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
        token physxScene:broadphaseType = "MBP"
    }
    def Cube "Floor" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, -0.5, 0)
        float3 xformOp:scale = (30, 1, 30)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Free" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 4, 0)
        float physics:mass = 1
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physxRigidBody:disableGravity = true
        custom bool fbik:quasiStatic = true
        vector3f physics:velocity = (3, 4, 5)
        vector3f physics:angularVelocity = (60, 70, 80)
        float physxRigidBody:linearDamping = 0
        float physxRigidBody:angularDamping = 0
    }
    def Cube "Contact" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"])
    {
        double size = 1
        double3 xformOp:translate = (3, 0.4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physxRigidBody:disableGravity = true
        custom bool fbik:quasiStatic = true
    }
    def Cube "Falling" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"])
    {
        double size = 1
        double3 xformOp:translate = (-3, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
